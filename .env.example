# Environment Configuration for Digital To-Do & Wellness Manager

# Django Core Settings
SECRET_KEY=django-insecure-wellness-todo-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL by default, set USE_SQLITE=True if testing without local MySQL server)
USE_SQLITE=False
DB_ENGINE=django.db.backends.mysql
DB_NAME=digital_todo_wellness_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Celery & Redis Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# If Redis is not running locally during development/testing, Celery can run tasks eagerly:
CELERY_TASK_ALWAYS_EAGER=False

# Google Calendar OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/calendar/oauth2callback/

# VAPID Keys for Web Push Notifications (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@digitalwellness.local
